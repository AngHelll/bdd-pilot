{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BDD Pilot: Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples/minimal-bdd"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "bundle extension"
    }
  ]
}
