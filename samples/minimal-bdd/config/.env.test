# Dogfood sample for BDD Pilot env loading (Capa B).
# Placeholders only — no secrets. Copied from config/env.example pattern.
#
# Load order when STAGE=test: config/.env.test then config/.env.local (if present).

STAGE=test

# Example: API base URL for your test project
# API_BASE_URL=https://api.example.test

# Example: browser toggles
# HEADLESS_MODE=true
