{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-test",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/security/**/*.ts",
    "src/agent/**/*.ts",
    "src/api/**/*.ts",
    "src/providers/runService.ts",
    "src/test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
