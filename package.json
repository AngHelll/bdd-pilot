{
  "name": "bdd-pilot",
  "displayName": "BDD Pilot",
  "description": "Gherkin cockpit for Reqnroll & SpecFlow in VS Code/Cursor: domain/@tag tree, STAGE hub, TRX↔scenario mapping — alongside Test Explorer, not a replacement. Use with BDD Guardian.",
  "version": "1.33.0",
  "publisher": "anghelll",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngHelll/bdd-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/AngHelll/bdd-pilot/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "bdd",
    "reqnroll",
    "specflow",
    "cucumber",
    "gherkin",
    "xunit",
    "dotnet",
    "dotnet test",
    "test explorer",
    "test runner",
    "playwright",
    "cursor",
    "copilot",
    "qa"
  ],
  "activationEvents": [
    "workspaceContains:**/*.feature"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "bdd-pilot",
        "label": "BDD Pilot"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bddPilot",
          "title": "%bddPilot.viewsContainer.title%",
          "icon": "media/pilot.svg"
        }
      ]
    },
    "views": {
      "bddPilot": [
        {
          "id": "bddPilot.tests",
          "name": "%bddPilot.view.tests.name%",
          "icon": "media/pilot.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "bddPilot.refresh",
        "title": "%bddPilot.command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "bddPilot.runNode",
        "title": "%bddPilot.command.runNode.title%",
        "icon": "$(run)",
        "enablement": "!bddPilot.running"
      },
      {
        "command": "bddPilot.debugNode",
        "title": "%bddPilot.command.debugNode.title%",
        "icon": "$(debug)",
        "enablement": "!bddPilot.running"
      },
      {
        "command": "bddPilot.runAll",
        "title": "%bddPilot.command.runAll.title%",
        "icon": "$(run-all)",
        "enablement": "!bddPilot.running"
      },
      {
        "command": "bddPilot.runFiltered",
        "title": "%bddPilot.command.runFiltered.title%",
        "icon": "$(run-all)",
        "enablement": "!bddPilot.running"
      },
      {
        "command": "bddPilot.cancel",
        "title": "%bddPilot.command.cancel.title%",
        "icon": "$(stop)"
      },
      {
        "command": "bddPilot.selectProject",
        "title": "%bddPilot.command.selectProject.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bddPilot.openStatusBarHub",
        "title": "%bddPilot.command.openStatusBarHub.title%",
        "icon": "$(beaker)"
      },
      {
        "command": "bddPilot.selectStage",
        "title": "%bddPilot.command.selectStage.title%",
        "icon": "$(symbol-environment)"
      },
      {
        "command": "bddPilot.selectMode",
        "title": "%bddPilot.command.selectMode.title%",
        "icon": "$(zap)"
      },
      {
        "command": "bddPilot.showOutput",
        "title": "%bddPilot.command.showOutput.title%"
      },
      {
        "command": "bddPilot.showDashboard",
        "title": "%bddPilot.command.showDashboard.title%",
        "shortTitle": "%bddPilot.command.showDashboard.shortTitle%",
        "icon": "$(graph)"
      },
      {
        "command": "bddPilot.showUnmappedScenarios",
        "title": "%bddPilot.command.showUnmappedScenarios.title%",
        "icon": "$(list-filter)"
      },
      {
        "command": "bddPilot.showScenarioHistory",
        "title": "%bddPilot.command.showScenarioHistory.title%",
        "icon": "$(history)"
      },
      {
        "command": "bddPilot.searchTests",
        "title": "%bddPilot.command.searchTests.title%",
        "icon": "$(search)"
      },
      {
        "command": "bddPilot.searchTestsActive",
        "title": "%bddPilot.command.searchTestsActive.title%",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "bddPilot.clearSearch",
        "title": "%bddPilot.command.clearSearch.title%",
        "icon": "$(close)"
      },
      {
        "command": "bddPilot.rerunFailed",
        "title": "%bddPilot.command.rerunFailed.title%",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "bddPilot.jumpToFirstFailure",
        "title": "%bddPilot.command.jumpToFirstFailure.title%",
        "icon": "$(error)"
      },
      {
        "command": "bddPilot.collapseToFailures",
        "title": "%bddPilot.command.collapseToFailures.title%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "bddPilot.runFromCodeLens",
        "title": "%bddPilot.command.runFromCodeLens.title%",
        "enablement": "!bddPilot.running"
      },
      {
        "command": "bddPilot.saveProfile",
        "title": "%bddPilot.command.saveProfile.title%",
        "icon": "$(save)"
      },
      {
        "command": "bddPilot.runProfile",
        "title": "%bddPilot.command.runProfile.title%",
        "icon": "$(run-above)",
        "enablement": "!bddPilot.running"
      },
      {
        "command": "bddPilot.cycleTreeGroupBy",
        "title": "%bddPilot.command.cycleTreeGroupBy.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "bddPilot.cycleTreeGroupByDomain",
        "title": "%bddPilot.command.cycleTreeGroupByDomain.title%",
        "icon": "$(folder)"
      },
      {
        "command": "bddPilot.cycleTreeGroupByTag",
        "title": "%bddPilot.command.cycleTreeGroupByTag.title%",
        "icon": "$(tag)"
      },
      {
        "command": "bddPilot.manageProfiles",
        "title": "%bddPilot.command.manageProfiles.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bddPilot.copyFailureContextForAi",
        "title": "%bddPilot.command.copyFailureContextForAi.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "bddPilot.copyEffectiveDotnetCommand",
        "title": "%bddPilot.command.copyEffectiveDotnetCommand.title%",
        "icon": "$(terminal)"
      }
    ],
    "submenus": [
      {
        "id": "bddPilot.moreMenu",
        "label": "%bddPilot.submenu.more.label%",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bddPilot.profilesMenu",
        "label": "%bddPilot.submenu.profiles.label%",
        "icon": "$(list-selection)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bddPilot.cancel",
          "when": "view == bddPilot.tests && bddPilot.running",
          "group": "navigation@0"
        },
        {
          "command": "bddPilot.runAll",
          "when": "view == bddPilot.tests && !bddPilot.searchActive && !bddPilot.running",
          "group": "navigation@1"
        },
        {
          "command": "bddPilot.runFiltered",
          "when": "view == bddPilot.tests && bddPilot.searchActive && bddPilot.searchHasMatches && !bddPilot.running",
          "group": "navigation@1"
        },
        {
          "command": "bddPilot.searchTests",
          "when": "view == bddPilot.tests && !bddPilot.searchActive",
          "group": "navigation@2"
        },
        {
          "command": "bddPilot.searchTestsActive",
          "when": "view == bddPilot.tests && bddPilot.searchActive",
          "group": "navigation@2"
        },
        {
          "command": "bddPilot.showDashboard",
          "when": "view == bddPilot.tests",
          "group": "navigation@4"
        },
        {
          "command": "bddPilot.collapseToFailures",
          "when": "view == bddPilot.tests",
          "group": "navigation@5"
        },
        {
          "command": "bddPilot.refresh",
          "when": "view == bddPilot.tests",
          "group": "navigation@6"
        },
        {
          "command": "bddPilot.cycleTreeGroupByDomain",
          "when": "view == bddPilot.tests && bddPilot.treeGroupBy == domain",
          "group": "navigation@7"
        },
        {
          "command": "bddPilot.cycleTreeGroupByTag",
          "when": "view == bddPilot.tests && bddPilot.treeGroupBy == tag",
          "group": "navigation@7"
        },
        {
          "submenu": "bddPilot.moreMenu",
          "when": "view == bddPilot.tests",
          "group": "navigation@8"
        }
      ],
      "bddPilot.moreMenu": [
        {
          "command": "bddPilot.jumpToFirstFailure",
          "group": "1_more@0"
        },
        {
          "command": "bddPilot.collapseToFailures",
          "group": "1_more@1"
        },
        {
          "command": "bddPilot.rerunFailed",
          "group": "1_more@2"
        },
        {
          "command": "bddPilot.showScenarioHistory",
          "group": "1_more@3"
        },
        {
          "submenu": "bddPilot.profilesMenu",
          "group": "1_more@4"
        }
      ],
      "bddPilot.profilesMenu": [
        {
          "command": "bddPilot.runProfile",
          "group": "1_profiles@1"
        },
        {
          "command": "bddPilot.saveProfile",
          "group": "1_profiles@2"
        },
        {
          "command": "bddPilot.manageProfiles",
          "group": "1_profiles@3"
        }
      ],
      "view/item/context": [
        {
          "command": "bddPilot.runNode",
          "when": "view == bddPilot.tests && viewItem =~ /^bddRunnable/ && !bddPilot.running",
          "group": "inline@1"
        },
        {
          "command": "bddPilot.debugNode",
          "when": "view == bddPilot.tests && viewItem =~ /^bddRunnable/ && !bddPilot.running",
          "group": "inline@2"
        },
        {
          "command": "bddPilot.showScenarioHistory",
          "when": "view == bddPilot.tests && viewItem =~ /^bddRunnable/",
          "group": "1_history@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bddPilot.searchTests",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "focusedView == bddPilot.tests"
      }
    ],
    "configuration": {
      "title": "BDD Pilot",
      "properties": {
        "bddPilot.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%bddPilot.configuration.locale.enum.auto%",
            "%bddPilot.configuration.locale.enum.en%",
            "%bddPilot.configuration.locale.enum.es%"
          ],
          "description": "%bddPilot.configuration.locale.description%"
        },
        "bddPilot.statusBar.display": {
          "type": "string",
          "enum": [
            "compact",
            "detailed"
          ],
          "default": "compact",
          "enumDescriptions": [
            "%bddPilot.configuration.statusBar.display.enum.compact%",
            "%bddPilot.configuration.statusBar.display.enum.detailed%"
          ],
          "description": "%bddPilot.configuration.statusBar.display.description%"
        },
        "bddPilot.projectPath": {
          "type": "string",
          "default": "",
          "description": "Relative or absolute path to the .NET test project directory, `.csproj`, `.sln`, or `.slnx`. If empty, auto-detect; when multiple projects exist, use 'Select Test Project'."
        },
        "bddPilot.defaultStage": {
          "type": "string",
          "enum": [
            "dev",
            "test",
            "stg",
            "prod"
          ],
          "default": "test",
          "enumDescriptions": [
            "%bddPilot.configuration.defaultStage.enum.dev%",
            "%bddPilot.configuration.defaultStage.enum.test%",
            "%bddPilot.configuration.defaultStage.enum.stg%",
            "%bddPilot.configuration.defaultStage.enum.prod%"
          ],
          "description": "%bddPilot.configuration.defaultStage.description%"
        },
        "bddPilot.defaultMode": {
          "type": "string",
          "enum": [
            "debug",
            "parallel",
            "ci"
          ],
          "default": "debug",
          "enumDescriptions": [
            "%bddPilot.configuration.defaultMode.enum.debug%",
            "%bddPilot.configuration.defaultMode.enum.parallel%",
            "%bddPilot.configuration.defaultMode.enum.ci%"
          ],
          "description": "%bddPilot.configuration.defaultMode.description%"
        },
        "bddPilot.requireConfirmationForStages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "stg",
            "prod"
          ],
          "description": "Environments that require explicit confirmation before running tests."
        },
        "bddPilot.security.allowProductionRuns": {
          "type": "boolean",
          "default": false,
          "description": "%bddPilot.configuration.security.allowProductionRuns.description%"
        },
        "bddPilot.preRun.bindingGate": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "block"
          ],
          "default": "warn",
          "enumDescriptions": [
            "%bddPilot.configuration.preRun.bindingGate.enum.off%",
            "%bddPilot.configuration.preRun.bindingGate.enum.warn%",
            "%bddPilot.configuration.preRun.bindingGate.enum.block%"
          ],
          "description": "%bddPilot.configuration.preRun.bindingGate.description%"
        },
        "bddPilot.diagnostics.extendedRules": {
          "type": "boolean",
          "default": false,
          "description": "%bddPilot.configuration.diagnostics.extendedRules.description%"
        },
        "bddPilot.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "Path to the dotnet executable."
        },
        "bddPilot.run.configuration": {
          "type": "string",
          "enum": [
            "",
            "Debug",
            "Release"
          ],
          "default": "",
          "enumDescriptions": [
            "%bddPilot.configuration.run.configuration.enum.default%",
            "%bddPilot.configuration.run.configuration.enum.debug%",
            "%bddPilot.configuration.run.configuration.enum.release%"
          ],
          "description": "%bddPilot.configuration.run.configuration.description%"
        },
        "bddPilot.run.noBuild": {
          "type": "boolean",
          "default": false,
          "description": "%bddPilot.configuration.run.noBuild.description%"
        },
        "bddPilot.run.runSettings": {
          "type": "string",
          "default": "",
          "description": "%bddPilot.configuration.run.runSettings.description%"
        },
        "bddPilot.run.cliVerbosity": {
          "type": "string",
          "enum": [
            "",
            "quiet",
            "minimal",
            "normal",
            "detailed",
            "diagnostic"
          ],
          "default": "",
          "enumDescriptions": [
            "%bddPilot.configuration.run.cliVerbosity.enum.default%",
            "%bddPilot.configuration.run.cliVerbosity.enum.quiet%",
            "%bddPilot.configuration.run.cliVerbosity.enum.minimal%",
            "%bddPilot.configuration.run.cliVerbosity.enum.normal%",
            "%bddPilot.configuration.run.cliVerbosity.enum.detailed%",
            "%bddPilot.configuration.run.cliVerbosity.enum.diagnostic%"
          ],
          "description": "%bddPilot.configuration.run.cliVerbosity.description%"
        },
        "bddPilot.run.blame": {
          "type": "boolean",
          "default": false,
          "description": "%bddPilot.configuration.run.blame.description%"
        },
        "bddPilot.run.blameHang": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ],
          "default": "off",
          "enumDescriptions": [
            "%bddPilot.configuration.run.blameHang.enum.off%",
            "%bddPilot.configuration.run.blameHang.enum.on%"
          ],
          "description": "%bddPilot.configuration.run.blameHang.description%"
        },
        "bddPilot.run.blameHangTimeout": {
          "type": "string",
          "default": "10m",
          "description": "%bddPilot.configuration.run.blameHangTimeout.description%"
        },
        "bddPilot.run.byStage": {
          "type": "object",
          "default": {},
          "description": "%bddPilot.configuration.run.byStage.description%"
        },
        "bddPilot.tree.displayMode": {
          "type": "string",
          "enum": [
            "compact",
            "detailed"
          ],
          "default": "detailed",
          "enumDescriptions": [
            "%bddPilot.configuration.tree.displayMode.enum.compact%",
            "%bddPilot.configuration.tree.displayMode.enum.detailed%"
          ],
          "description": "%bddPilot.configuration.tree.displayMode.description%"
        },
        "bddPilot.tree.groupBy": {
          "type": "string",
          "enum": [
            "domain",
            "tag"
          ],
          "default": "domain",
          "enumDescriptions": [
            "%bddPilot.configuration.tree.groupBy.enum.domain%",
            "%bddPilot.configuration.tree.groupBy.enum.tag%"
          ],
          "description": "%bddPilot.configuration.tree.groupBy.description%"
        },
        "bddPilot.tree.searchRunCap": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "description": "%bddPilot.configuration.tree.searchRunCap.description%"
        },
        "bddPilot.tree.tagDisplay": {
          "type": "string",
          "enum": [
            "hidden",
            "count",
            "compact",
            "full"
          ],
          "default": "count",
          "enumDescriptions": [
            "%bddPilot.configuration.tree.tagDisplay.enum.hidden%",
            "%bddPilot.configuration.tree.tagDisplay.enum.count%",
            "%bddPilot.configuration.tree.tagDisplay.enum.compact%",
            "%bddPilot.configuration.tree.tagDisplay.enum.full%"
          ],
          "description": "%bddPilot.configuration.tree.tagDisplay.description%"
        },
        "bddPilot.tree.compactTagLimit": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "When tree.tagDisplay is \"compact\", maximum number of @tags shown before \"+N\"."
        },
        "bddPilot.tree.durationDisplay": {
          "type": "string",
          "enum": [
            "auto",
            "ms",
            "seconds",
            "compact"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%bddPilot.configuration.tree.durationDisplay.enum.auto%",
            "%bddPilot.configuration.tree.durationDisplay.enum.ms%",
            "%bddPilot.configuration.tree.durationDisplay.enum.seconds%",
            "%bddPilot.configuration.tree.durationDisplay.enum.compact%"
          ],
          "description": "%bddPilot.configuration.tree.durationDisplay.description%"
        },
        "bddPilot.filter.featureClassSuffix": {
          "type": "string",
          "default": "Feature",
          "description": "Suffix appended to the sanitized feature title for FullyQualifiedName filters. Reqnroll/SpecFlow default is \"Feature\". Set to empty when the generated class has no suffix."
        },
        "bddPilot.filter.tagTraitName": {
          "type": "string",
          "default": "Category",
          "description": "xUnit trait name used for Gherkin @tags in dotnet test --filter (default Category)."
        },
        "bddPilot.filter.outlineRowFilter": {
          "type": "string",
          "enum": [
            "displayName",
            "scenarioOnly"
          ],
          "default": "displayName",
          "enumDescriptions": [
            "%bddPilot.configuration.filter.outlineRowFilter.enum.displayName%",
            "%bddPilot.configuration.filter.outlineRowFilter.enum.scenarioOnly%"
          ],
          "description": "%bddPilot.configuration.filter.outlineRowFilter.description%"
        },
        "bddPilot.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%bddPilot.configuration.ai.enabled.description%"
        },
        "bddPilot.ai.contextMaxOutputLines": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 500,
          "description": "%bddPilot.configuration.ai.contextMaxOutputLines.description%"
        },
        "bddPilot.ai.rehydrateFromTrx": {
          "type": "boolean",
          "default": false,
          "description": "%bddPilot.configuration.ai.rehydrateFromTrx.description%"
        },
        "bddPilot.feedback.postRunToast": {
          "type": "string",
          "enum": [
            "off",
            "failures",
            "always"
          ],
          "default": "failures",
          "enumDescriptions": [
            "%bddPilot.configuration.feedback.postRunToast.enum.off%",
            "%bddPilot.configuration.feedback.postRunToast.enum.failures%",
            "%bddPilot.configuration.feedback.postRunToast.enum.always%"
          ],
          "description": "%bddPilot.configuration.feedback.postRunToast.description%"
        },
        "bddPilot.feedback.diagnosticsInOutput": {
          "type": "string",
          "enum": [
            "off",
            "summary",
            "full"
          ],
          "default": "summary",
          "enumDescriptions": [
            "%bddPilot.configuration.feedback.diagnosticsInOutput.enum.off%",
            "%bddPilot.configuration.feedback.diagnosticsInOutput.enum.summary%",
            "%bddPilot.configuration.feedback.diagnosticsInOutput.enum.full%"
          ],
          "description": "%bddPilot.configuration.feedback.diagnosticsInOutput.description%"
        },
        "bddPilot.feedback.dotnetVerbosity": {
          "type": "string",
          "enum": [
            "filtered",
            "raw"
          ],
          "default": "filtered",
          "enumDescriptions": [
            "%bddPilot.configuration.feedback.dotnetVerbosity.enum.filtered%",
            "%bddPilot.configuration.feedback.dotnetVerbosity.enum.raw%"
          ],
          "description": "%bddPilot.configuration.feedback.dotnetVerbosity.description%"
        },
        "bddPilot.feedback.autoShowOutput": {
          "type": "string",
          "enum": [
            "off",
            "onFailure",
            "always"
          ],
          "default": "off",
          "enumDescriptions": [
            "%bddPilot.configuration.feedback.autoShowOutput.enum.off%",
            "%bddPilot.configuration.feedback.autoShowOutput.enum.onFailure%",
            "%bddPilot.configuration.feedback.autoShowOutput.enum.always%"
          ],
          "description": "%bddPilot.configuration.feedback.autoShowOutput.description%"
        },
        "bddPilot.outcomes.rehydrateOnActivate": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "default": "on",
          "enumDescriptions": [
            "%bddPilot.configuration.outcomes.rehydrateOnActivate.enum.on%",
            "%bddPilot.configuration.outcomes.rehydrateOnActivate.enum.off%"
          ],
          "description": "%bddPilot.configuration.outcomes.rehydrateOnActivate.description%"
        },
        "bddPilot.outcomes.rehydrateMaxAgeHours": {
          "type": "number",
          "default": 168,
          "minimum": 0,
          "description": "Ignore TRX files older than this many hours when rehydrating on activate. 0 = no age limit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:headless && npm run build:mcp && node esbuild.js --production",
    "build:headless": "tsc -p tsconfig.headless.json",
    "build:mcp": "node scripts/build-pilot-mcp.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
